# Environment variables required for development and production

# Server session secret
SESSION_SECRET=your-session-secret

# Pi Network server API keys
PI_API_KEY_TESTNET=your-testnet-api-key
PI_NETWORK_API_KEY=your-mainnet-active-api-key
PI_API_KEY_MAINNET=your-mainnet-api-key

# Pi App wallet seeds (server-only; do NOT commit real values)
PI_APP_WALLET_SEED_TESTNET=your-testnet-wallet-seed
PI_APP_WALLET_SEED_MAINNET=your-mainnet-wallet-seed

# CiDi configuration
VITE_CIDI_API_KEY=your-cidi-api-key
VITE_CIDI_BASE_URL=https://elf-proxy.cidi.games/api/v1

# Supabase (if used)
SUPABASE_URL=https://your-supabase-url
SUPABASE_SERVICE_KEY=your-supabase-service-key
